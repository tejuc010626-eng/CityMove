<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back button -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←  Back"
            android:textColor="#315B47"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="20dp"/>

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your journey"
            android:textColor="#1D2922"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/journeySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your route"
            android:textColor="#66736A"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- Route option 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECOMMENDED"
                android:textColor="#315B47"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/accessibility_background"
                android:padding="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35 min"
                android:textColor="#1D2922"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Metro + walking"
                android:textColor="#66736A"
                android:textSize="15sp"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E7EBE7"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚇  Metro"
                android:textColor="#315B47"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Travel by metro with a short walk to your destination."
                android:textColor="#66736A"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimated fare: ₹30"
                android:textColor="#1D2922"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/viewRouteButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="View route"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/button_background"
                android:backgroundTint="@null"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

        <!-- Route option 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALTERNATIVE"
                android:textColor="#66736A"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="50 min"
                android:textColor="#1D2922"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bus"
                android:textColor="#66736A"
                android:textSize="15sp"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E7EBE7"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚌  Bus"
                android:textColor="#315B47"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Direct bus route with fewer transfers."
                android:textColor="#66736A"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimated fare: ₹15"
                android:textColor="#1D2922"
                android:textSize="14sp"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <!-- Accessibility -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/accessibility_background"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Accessibility information"
                android:textColor="#315B47"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check elevators, step-free access and other accessibility facilities along your journey."
                android:textColor="#526358"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>